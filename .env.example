# Copy to .env (mode 0600). Only non-secret deployment settings go here.
# Put private values in files under ./secrets (see tools.init_secrets).
PUBLIC_HOST=alerts.example.com
PUBLIC_BASE_URL=https://alerts.example.com
ACME_EMAIL=admin@example.com
ADMIN_USERNAME=admin
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
ALERT_SENDER_EMAIL=alerts@example.com
ENABLE_SCRAPER=false
# Linux amd64 / Python 3.12 is the supported locked image target.
INSTALL_SCRAPER=false
# Secret file references below are consumed by Compose, not stored in images.
ADMIN_PASSWORD_HASH_FILE=./secrets/admin_password_hash
TOKEN_SECRET_FILE=./secrets/token_secret
SMTP_USERNAME_FILE=./secrets/smtp_username
SMTP_PASSWORD_FILE=./secrets/smtp_password
SERPAPI_API_KEY_FILE=./secrets/serpapi_api_key
KIWI_API_KEY_FILE=./secrets/kiwi_api_key
AVIATIONSTACK_API_KEY_FILE=./secrets/aviationstack_api_key
